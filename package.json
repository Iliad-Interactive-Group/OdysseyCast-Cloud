{
  "name": "odysseycast",
  "version": "0.1.0",
  "description": "OdysseyCast standalone radio operations workspace for weather, traffic, voice tracking, and scheduling.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WATCHPACK_POLLING=true WATCHPACK_POLLING_INTERVAL=1000 next dev --port 9012",
