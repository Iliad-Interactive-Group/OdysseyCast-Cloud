# App
NODE_ENV=development
PORT=9012

# Central auth (iig-core Firebase Auth client). PROJECT_ID must be iig-core.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=iig-core
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# AI / TTS
GOOGLE_GENAI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Traffic provider
TOMTOM_API_KEY=

# Firebase Admin for this app's own Firestore/Storage project (choose one approach).
# Also used to verify iig-core ID tokens (only needs the iig-core project ID).
# 1) Full service account JSON payload (recommended for local)
FIREBASE_SERVICE_ACCOUNT_JSON=
# 2) Or explicit values
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Apollo Music Scheduler integration (Music Logs module)
APOLLO_MUSIC_SCHEDULER_BASE_URL=http://127.0.0.1:8090
APOLLO_MUSIC_SCHEDULER_UI_BASE_URL=http://127.0.0.1:8090
APOLLO_MUSIC_SCHEDULER_EMAIL=
APOLLO_MUSIC_SCHEDULER_PASSWORD=

# OdysseyCast-Automation integration
ODYSSEY_AUTOMATION_WEB_BASE_URL=http://127.0.0.1:5173
ODYSSEY_AUTOMATION_RUNTIME_API_BASE_URL=http://127.0.0.1:5179

# Local-only admin proxy (disabled by default, never enabled in production)
ODYSSEY_AUTOMATION_LOCAL_ADMIN_ENABLED=false
ODYSSEY_AUTOMATION_LOCAL_ADMIN_BASE_URL=http://127.0.0.1:5179
