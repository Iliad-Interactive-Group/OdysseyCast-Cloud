# App
NODE_ENV=development
PORT=9012

# Local auth defaults (non-production only)
ODYSSEY_DEV_AUTH_BYPASS=true
NEXT_PUBLIC_ODYSSEY_DEV_AUTH=true
NEXT_PUBLIC_ODYSSEY_DEFAULT_TENANT=iig-core

# AI / TTS
GOOGLE_GENAI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Traffic provider
TOMTOM_API_KEY=

# Firebase Admin (choose one approach)
# 1) Full service account JSON payload (recommended for local)
FIREBASE_SERVICE_ACCOUNT_JSON=
# 2) Or explicit values
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
